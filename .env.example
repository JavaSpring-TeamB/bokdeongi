# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.

# MySQL (docker-compose와 backend가 함께 사용)
DB_URL=jdbc:mysql://localhost:3306/bokdeongi # 변경 필요
DB_USERNAME=root
DB_PASSWORD=change-me

# 공공데이터포털 인증키 (행정안전부 대한민국 공공서비스(혜택) 정보)
DATA_GO_KR_SERVICE_KEY=
# 공공서비스 API 동기화 (docs/api-sync.md). 공용 DB에 쓰므로 배포 서버 한 곳에서만 true
SYNC_ENABLED=false
SYNC_RUN_ON_STARTUP=false

# LLM (Gemini). 회원 정보(프로필·민감정보·답변·사용자가 쓴 글)는 보내지 않는다. 공개 공고문만 (D-92)
# 키가 있는 사람만 두 줄을 채운다. AI_CHAT_MODEL=none이면 LLM 기능만 꺼지고 서버는 뜬다
GEMINI_API_KEY=
AI_CHAT_MODEL=none
# 모델·생각 수준을 바꿀 때만 주석을 푼다. 빈 값으로 두면 기본값(gemini-3.8-flash, LOW)을 덮어쓴다 (D-97)
# GEMINI_MODEL=
# GEMINI_THINKING_LEVEL=
# DATA-03 조건 추출: 돌릴 공고의 서비스ID를 쉼표로. 서버 시작 직후 한 번 돌고, 돌린 뒤에는 비운다 (B만, D-93)
CONDITIONS_SERVICE_IDS=

# 인증
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 민감 항목 컬럼 암호화 키
FIELD_ENCRYPTION_KEY=

# 로컬 OCR 서버
OCR_SERVER_URL=http://localhost:8001
