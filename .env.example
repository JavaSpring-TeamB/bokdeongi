# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.

# PostgreSQL (docker-compose와 backend가 함께 사용)
POSTGRES_DB=bokdeongi
POSTGRES_USER=bokdeongi
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/bokdeongi

# 공공데이터포털 인증키 (행정안전부 대한민국 공공서비스(혜택) 정보)
DATA_GO_KR_SERVICE_KEY=

# LLM (Gemini). 개발 중 무료 등급에는 테스트 데이터만 사용
GEMINI_API_KEY=

# 인증
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 민감 항목 컬럼 암호화 키
FIELD_ENCRYPTION_KEY=

# 로컬 OCR 서버
OCR_SERVER_URL=http://localhost:8001
